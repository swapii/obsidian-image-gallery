{
  "name": "obsidian-image-gallery",
  "version": "0.0.1",
  "description": "Render a list of image URLs as a justified-rows gallery with a full-screen viewer.",
  "main": "main.js",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
    "test": "bun test"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "image",
    "gallery",
    "justified"
  ],
  "author": "swapii",
  "license": "MIT",
  "devDependencies": {
    "@types/imagesloaded": "^4.1.7",
    "@types/node": "^20.11.0",
    "@types/sortablejs": "^1.15.9",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "imagesloaded": "^5.0.0",
    "photoswipe": "^5.4.4",
    "sortablejs": "^1.15.7"
  }
}
